# Copy to .env (git-ignored). Only the cloud scripts under scripts/ read these; the local stack needs none.
PROJECT_ID=example-sandbox-0000     # your sandbox project id
REGION=europe-west1
BILLING_ACCOUNT=AAAAAA-BBBBBB-CCCCCC # gcloud billing accounts list
ORG_ID=                              # gcloud organizations list; leave empty without an organization
BUDGET_AMOUNT=10
